#include <winver.h>

#include "version.h"

IDI_ICON1 ICON "twotbit.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TWOTBIT_VERSION_MAJOR, TWOTBIT_VERSION_MINOR, TWOTBIT_VERSION_PATCH, 0
PRODUCTVERSION  TWOTBIT_VERSION_MAJOR, TWOTBIT_VERSION_MINOR, TWOTBIT_VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "pin2t"
            VALUE "FileDescription",  "Twotbit, an SPV Bitcoin wallet"
            VALUE "FileVersion",      TWOTBIT_VERSION_STRING
            VALUE "InternalName",     "Twotbit"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Ilya Pokolev. MIT License."
            VALUE "OriginalFilename", "Twotbit.exe"
            VALUE "ProductName",      "Twotbit"
            VALUE "ProductVersion",   TWOTBIT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
